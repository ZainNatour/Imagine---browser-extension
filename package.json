    "@dnd-kit/sortable": "^10.0.0",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@headlessui/react": "^2.2.4",
    "@lhci/cli": "^0.13.0",
    "@mui/material": "^5.15.13",
    "@radix-ui/react-accordion": "^1.2.11",

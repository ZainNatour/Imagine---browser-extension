{
  "name": "chrome-extension",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node test/urlUtils.test.mjs && node test/photoStorage.test.mjs && node test/wishlist.test.mjs && node test/storeService.test.mjs && node test/tryOnService.test.mjs && npx jest",
    "lint": "eslint src test",
    "dev": "vite --mode development",
    "build": "vite build",
    "analyze": "rollup-bundle-visualizer dist/manifest.json",
    "test:e2e": "npm test -- -t 'end-to-end'",
    "audit:lighthouse": "vite preview & lhci autorun && kill $!",
    "lhci": "vite preview --port 5173 --host 0.0.0.0 & lhci autorun --upload.target=temporary-public-storage && pkill -f vite",
    "size:gzip": "tar -czf - dist | wc -c"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Imagine browser extension",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@dnd-kit/accessibility": "^3.1.1",

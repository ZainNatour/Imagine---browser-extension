{
  "env": {
    "browser": true,
    "es2021": true
  },
  "root": true,
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "chrome": "readonly",
    "Buffer": "readonly"
  },
  "rules": {
    "indent": ["error", 2],
    "semi": ["error", "always"]
  },
  "overrides": [
    {
      "files": ["test/**/*.{ts,tsx,mjs}"],
      "env": { "jest": true, "node": true }
    }
  ]
}

{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "chrome": "readonly",
    "Buffer": "readonly"
  },
  "rules": {
    "indent": ["error", 2],
    "semi": ["error", "always"]
  },
  "overrides": [
    {
      "files": ["test/**/*.mjs"],
      "env": {
        "node": true
      }
    }
  ]
}
